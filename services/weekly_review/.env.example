# Never place provider keys in the iOS app or commit a real .env file.
# Copy this file to .env only for local development.
WEEKLY_REVIEW_ENVIRONMENT=development

# "disabled" rejects every request. "development_token" is for synthetic local
# testing only. Production requires "apple" and the exact native app bundle ID.
WEEKLY_REVIEW_AUTH_MODE=disabled
WEEKLY_REVIEW_DEVELOPMENT_TOKEN=
WEEKLY_REVIEW_APPLE_AUDIENCE=Marcus.Marathon
WEEKLY_REVIEW_APPLE_TOKEN_MAX_AGE_SECONDS=3600

# In-process limits. A deployed gateway must enforce shared multi-worker limits.
WEEKLY_REVIEW_REQUESTS_PER_MINUTE=6
WEEKLY_REVIEW_REQUESTS_PER_DAY=24
WEEKLY_REVIEW_MAX_REQUEST_BYTES=131072

# Explicit selection: disabled (default), azure, or openai. No auto-selection
# from existing keys and no fallback to a different provider.
# The app's WEEKLY_REVIEW_PROVIDER build setting must match this selection.
WEEKLY_REVIEW_PROVIDER=disabled

# Azure API-key path only. Fill all three on the server after choosing Azure.
# The endpoint must be an approved Azure HTTPS resource; see README.md.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=

# Direct OpenAI API-key path only. Explicit structured-output-capable model
# required; there is no default model and OPENAI_BASE_URL is not supported.
# This is not a ChatGPT plan/Pro OAuth token configuration.
OPENAI_MODEL=
OPENAI_API_KEY=

# Keep live traffic disabled until provider/deployment privacy review and
# separate authorization for a synthetic live smoke test are complete.
